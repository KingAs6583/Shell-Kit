# ~/.bash_function.linux — Linux-only shell functions
# Works on: Linux ONLY
# Sourced by ~/.bashrc only when PLATFORM=linux
# [linux] tag means this function requires apt/systemd/dmidecode etc.

# ─────────────────────────────────────────────────────────────
# LINUX PLATFORM GUARD
# ─────────────────────────────────────────────────────────────
if [ "${PLATFORM:-}" != "linux" ]; then
    return 0 2>/dev/null || exit 0
fi

# ─────────────────────────────────────────────────────────────
# LINE / SEPARATOR HELPER  [linux]
# ─────────────────────────────────────────────────────────────
_line() {
    local col
    col=$(tput cols 2>/dev/null || echo 80)
    if [ "$col" -gt 80 ]; then
        printf '%0.s-' {1..100}
    else
        printf '%0.s-' {1..70}
    fi
    echo ""
}

# ─────────────────────────────────────────────────────────────
# SYSTEM UPDATE  [linux]
# Full apt update + upgrade + autoremove + autoclean cycle
# Usage: sysupdate
# ─────────────────────────────────────────────────────────────
sysupdate() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: sysupdate"
        return 0
    fi

    local _CYAN='\033[0;36m'
    local _GREEN='\033[0;32m'
    local _BOLD='\033[1m'
    local _RST='\033[0m'

    _line
    printf "${_CYAN}${_BOLD}  Starting full system update...${_RST}\n"
    _line

    echo ""
    printf "${_CYAN}  [1/4] apt update${_RST}\n"
    sudo apt update

    echo ""
    printf "${_CYAN}  [2/4] apt upgrade${_RST}\n"
    sudo apt upgrade -y

    echo ""
    printf "${_CYAN}  [3/4] apt autoremove${_RST}\n"
    sudo apt autoremove -y

    echo ""
    printf "${_CYAN}  [4/4] apt autoclean${_RST}\n"
    sudo apt autoclean

    _line
    printf "${_GREEN}${_BOLD}  System update complete!${_RST}\n"
    _line
}

# ─────────────────────────────────────────────────────────────
# APT CLEANUP ONLY  [linux]
# Usage: aptclean
# ─────────────────────────────────────────────────────────────
aptclean() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: aptclean"
        return 0
    fi

    local _CYAN='\033[0;36m'
    local _GREEN='\033[0;32m'
    local _RST='\033[0m'

    printf "${_CYAN}  Cleaning up unused packages...${_RST}\n"
    sudo apt autoremove -y
    sudo apt autoclean
    printf "${_GREEN}  Clean complete.${_RST}\n"
}

# ─────────────────────────────────────────────────────────────
# SYSTEM INFO  [linux] (LAZY LOADED STUB)
# Usage: sysinfo [type]
# ─────────────────────────────────────────────────────────────
sysinfo() {
    source "$HOME/.local/share/shell-kit/lazy/sysinfo.sh"
    sysinfo "$@"
}

# ─────────────────────────────────────────────────────────────
# RAM INFO  [linux] (LAZY LOADED STUB)
# Usage: raminfo
# ─────────────────────────────────────────────────────────────
raminfo() {
    source "$HOME/.local/share/shell-kit/lazy/raminfo.sh"
    raminfo "$@"
}

# ─────────────────────────────────────────────────────────────
# FILE/DIR SCANNER  [linux] (LAZY LOADED STUB)
# Usage: scandisk [path]
# ─────────────────────────────────────────────────────────────
scandisk() {
    source "$HOME/.local/share/shell-kit/lazy/scandisk.sh"
    scandisk "$@"
}
