# ─────────────────────────────────────────────────────────────
# DIRECTORY STACK NAVIGATOR (d) [both]
# ─────────────────────────────────────────────────────────────

declare -a __shkit_dir_stack=()

cd() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        builtin cd --help
        return $?
    fi

    local prev_dir="$PWD"
    builtin cd "$@" || return $?

    local current_dir
    current_dir="$(pwd)"

    if [ "$prev_dir" != "$current_dir" ]; then
        local temp_stack=()
        for item in "${__shkit_dir_stack[@]:-}"; do
            if [ -n "$item" ] && [ "$item" != "$prev_dir" ] && [ "$item" != "$current_dir" ]; then
                temp_stack+=("$item")
            fi
        done

        __shkit_dir_stack=("$prev_dir" "${temp_stack[@]:-}")

        if [ "${#__shkit_dir_stack[@]}" -gt 9 ]; then
            __shkit_dir_stack=("${__shkit_dir_stack[@]:0:9}")
        fi
    fi
}

d() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: d"
        echo ""
        echo "Display the directory stack and jump back using numbers 1-9."
        return 0
    fi

    if [ "${#__shkit_dir_stack[@]}" -eq 0 ]; then
        echo "Directory stack is empty."
        return 0
    fi

    local idx=1
    for dir in "${__shkit_dir_stack[@]}"; do
        local display_dir="$dir"
        if [[ "$dir" == "$HOME"* ]]; then
            display_dir="~${dir#$HOME}"
        fi
        printf "  %d  %s\n" "$idx" "$display_dir"
        idx=$((idx + 1))
    done
}

1() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Jump to stack directory 1"
        return 0
    fi
    if [ -n "${__shkit_dir_stack[0]:-}" ]; then builtin cd "${__shkit_dir_stack[0]}" && pwd; else echo "Stack index 1 not set"; return 1; fi
}

2() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Jump to stack directory 2"
        return 0
    fi
    if [ -n "${__shkit_dir_stack[1]:-}" ]; then builtin cd "${__shkit_dir_stack[1]}" && pwd; else echo "Stack index 2 not set"; return 1; fi
}

3() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
