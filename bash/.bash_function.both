# ~/.bash_function.both — Cross-platform shell functions
# Works on: Windows (Git Bash), Linux, macOS
# Sourced by ~/.bashrc when PLATFORM is detected.
# [both] tag means function works everywhere.

# ─────────────────────────────────────────────────────────────
# CENTRAL TOOLKIT MANUAL  [both]
# ─────────────────────────────────────────────────────────────

manual() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: manual"
        return 0
    fi

    local C='\033[0;36m'   # cyan
    local Y='\033[1;33m'   # yellow
    local G='\033[0;32m'   # green
    local B='\033[1m'      # bold
    local R='\033[0m'      # reset
    
    printf "\n"
    printf "${C}======================================================================${R}\n"
    printf "${C}                 shell-kit TOOLKIT MANUAL & HELP${R}\n"
    printf "${C}======================================================================${R}\n"
    printf "\n"
    printf "${Y}1. DOTFILES MANAGEMENT${R}\n"
    printf "  ${G}dotfiles verify${R}      Verify local configs vs git repository\n"
    printf "  ${G}dotfiles install${R}     Symlink/copy configs to correct paths\n"
    printf "  ${G}dotfiles sync${R}        Stage, commit, and push repository changes\n"
    printf "  ${G}dotfiles status${R}      Show git status and commits history\n"
    printf "\n"
    printf "${Y}2. BACKUP & SYSTEM SYNC${R}\n"
    printf "  ${G}bkscan${R}               Scan project directories for dirty git repos\n"
    printf "  ${G}bkrun${R}                Orchestrated scan + assets backup run\n"
    printf "  ${G}bkrestore${R}            Interactively restore/unzip asset archives\n"
    printf "  ${G}cfginspect${R}           Inspect configuration directory storage bloat\n"
    printf "\n"
    printf "${Y}3. GIT UTILITIES${R}\n"
    printf "  ${G}setupGit${R}             Initialize repo, stage files, and push to remote\n"
    printf "  ${G}upload${R}               Quick git add, commit, and push\n"
    printf "  ${G}globalConfig${R}         Set Git user name and email globally\n"
    printf "  ${G}localConfig${R}          Set Git user name and email locally\n"
    printf "  ${G}listSshConfig${R}        List active Host aliases in ~/.ssh/config\n"
    printf "  ${G}setupGithubSshKey${R}    Generate SSH key and setup GitHub integration\n"
    printf "\n"
    printf "${Y}4. HELP & UTILS${R}\n"
    printf "  ${G}manual${R}               Show this unified toolkit guide\n"
    printf "  ${G}hhelp${R}                Show shell history cheat sheet\n"
    printf "  ${G}pyvenvs${R}              Find Python virtual environments\n"
    printf "  ${G}pkglist / pkgscan${R}    Show/update history package cache\n"
    printf "\n"
    printf "${Y}5. LINUX UTILITIES [linux]${R}\n"
    printf "  ${G}sysupdate${R}            Full apt update/upgrade/clean cycle\n"
    printf "  ${G}aptclean${R}             Apt cleanup of unused packages\n"
    printf "  ${G}sysinfo${R}              Hardware system info via dmidecode\n"
    printf "  ${G}raminfo${R}              Hardware & usage RAM details\n"
    printf "  ${G}scandisk${R}             Scan directory for large or old files\n"
    printf "\n"
    printf "${Y}6. WINDOWS UTILITIES [windows]${R}\n"
    printf "  ${G}explore${R}              Open directory in Windows Explorer\n"
    printf "  ${G}open${R}                 Open file or URL in default Windows app\n"
    printf "  ${G}toUnix${R}               Convert Windows path format to Unix\n"
    printf "  ${G}toWin${R}                Convert Unix path format to Windows\n"
    printf "  ${G}killwin${R}              Force kill a Windows process by name\n"
    printf "  ${G}pslist${R}               List active Windows processes with memory\n"
    printf "  ${G}devmode${R}              Check Windows Developer Mode status\n"
    printf "\n"
    printf "${C}Note: Every command above accepts --help or -h for signature details.${R}\n"
    printf "${C}======================================================================${R}\n"
    printf "\n"
}

# ─────────────────────────────────────────────────────────────
# GIT IDENTITY SETUP  [both]
# ─────────────────────────────────────────────────────────────

# Set git identity globally on this machine
globalConfig() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: globalConfig"
        return 0
    fi

    echo ""
    read -r -p "  Enter User Name  : " userName
    read -r -p "  Enter Email Address : " email

    git config --global user.name "$userName"
    git config --global user.email "$email"

    echo ""
    echo "  Global git config set:"
    git config --list | grep -E "^user\."
    unset -v userName email
}

# Set git identity for this repo only
localConfig() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: localConfig"
        return 0
    fi

    echo ""
    read -r -p "  Enter User Name  : " userName
    read -r -p "  Enter Email Address : " email

    git config user.name "$userName"
    git config user.email "$email"

    echo ""
    echo "  Local repo git config set:"
    git config --list | grep -E "^user\."
    unset -v userName email
}

# ─────────────────────────────────────────────────────────────
# GIT REPO SETUP  [both] (LAZY LOADED STUB)
# ─────────────────────────────────────────────────────────────

# Initialize a new repo, make first commit, push to remote
setupGit() {
    source "$HOME/.local/share/shell-kit/lazy/setupGit.sh"
    setupGit "$@"
}

# Quick add+commit+push to existing repo
# Usage: upload "commit message"
upload() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: upload \"commit message\""
        return 0
    fi

    if [ -z "${1:-}" ]; then
        echo "Usage: upload \"commit message\""
        return 1
    fi
    git add .
    git commit -m "$1"
    git push -u origin main
    git status
    _git_hint
}

# Internal: git quick-reference hint
_git_hint() {
    echo ""
    echo "  Quick reference:"
    echo "    git-add | git-branch | git-push | git-remote | git-config"
    echo "    git --help | more"
    echo "    git push -f  (if remote asks to pull first)"
}

# ─────────────────────────────────────────────────────────────
# SSH KEY MANAGEMENT  [both] (LAZY LOADED STUB & HELP)
# ─────────────────────────────────────────────────────────────

# List all SSH host aliases and their identity files from ~/.ssh/config
listSshConfig() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: listSshConfig"
        return 0
    fi

    local config_path="$HOME/.ssh/config"

    if [ ! -f "$config_path" ]; then
        echo "  No ~/.ssh/config file found."
        return 0
    fi

    local _CYAN='\033[0;36m'
    local _GREEN='\033[0;32m'
    local _BOLD='\033[1m'
    local _RST='\033[0m'

    printf "\n${_CYAN}${_BOLD}SSH Host Aliases:${_RST}\n"
    printf "%-25s %-15s %s\n" "Host Alias" "Hostname" "IdentityFile"
    printf "%-25s %-15s %s\n" "-------------------------" "---------------" "------------------------"

    awk '
    /^Host / {
        if (host != "") {
            printf "%-25s %-15s %s\n", host, hostname, identity
        }
        host = $2; hostname = ""; identity = "not-set"
    }
    /^[[:space:]]+HostName / { hostname = $2 }
    /^[[:space:]]+IdentityFile / { identity = $2 }
    END {
        if (host != "") {
            printf "%-25s %-15s %s\n", host, hostname, identity
        }
    }
    ' "$config_path"
    printf "\n"
}

# Interactive SSH key generator for GitHub
setupGithubSshKey() {
    source "$HOME/.local/share/shell-kit/lazy/setupGithubSshKey.sh"
    setupGithubSshKey "$@"
}

# ─────────────────────────────────────────────────────────────
# BACKUP & CONFIG MANAGEMENT  [both]
# ─────────────────────────────────────────────────────────────

# Helper to run python script using python3 or python
_run_py_script() {
    local script="$1"
    shift
    if command -v python3 &>/dev/null; then
        python3 "$script" "$@"
    elif command -v python &>/dev/null; then
        python "$script" "$@"
    else
        echo "Error: Python is not installed or not in PATH." >&2
        return 1
    fi
}

bkscan() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: bkscan [OPTIONS]"
        return 0
    fi
    _run_py_script "$HOME/.local/bin/git_scanner.py" "$@"
}

bkrun() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: bkrun [OPTIONS]"
        return 0
    fi
    _run_py_script "$HOME/.local/bin/backup.py" "$@"
}

bkrestore() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: bkrestore [OPTIONS]"
        return 0
    fi
    _run_py_script "$HOME/.local/bin/asset_backup.py" --restore "$@"
}

cfginspect() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: cfginspect [OPTIONS]"
        return 0
    fi
    _run_py_script "$HOME/.local/bin/config_inspector.py" "$@"
}
