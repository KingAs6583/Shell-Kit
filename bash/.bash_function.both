    fi
    if [ -n "${__shkit_dir_stack[2]:-}" ]; then builtin cd "${__shkit_dir_stack[2]}" && pwd; else echo "Stack index 3 not set"; return 1; fi
}

4() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Jump to stack directory 4"
        return 0
    fi
    if [ -n "${__shkit_dir_stack[3]:-}" ]; then builtin cd "${__shkit_dir_stack[3]}" && pwd; else echo "Stack index 4 not set"; return 1; fi
}

5() {
