envmgr() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        _run_py_script "$HOME/.local/bin/envmgr.py" --help
        return 0
    fi

    if [ "$#" -eq 0 ]; then
        _run_py_script "$HOME/.local/bin/envmgr.py" --help
        return 0
    fi

    local cmd="$1"
    shift

    # --cleanup doesn't need PATH argument
    if [ "$cmd" = "--cleanup" ]; then
        _run_py_script "$HOME/.local/bin/envmgr.py" "--cleanup"
        return $?
    fi

    local cmd_output
    cmd_output=$(_run_py_script "$HOME/.local/bin/envmgr.py" "$cmd" "$PATH" "$@")
    local ret=$?
    if [ $ret -eq 0 ] && [ -n "$cmd_output" ]; then
        eval "$cmd_output"
    fi
    return $ret
}

