clipcopy() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: clipcopy [--huge | --bridge]"
        echo ""
        echo "Copy stdin content to the system clipboard."
        echo ""
        echo "Options:"
        echo "  --huge, --bridge   Use local background HTTP service tunnel (requires ssh -R)"
        return 0
    fi

    local mode="local"
    if [ -n "${SSH_CONNECTION:-}" ] || [ -n "${SSH_CLIENT:-}" ] || [ -n "${SSH_TTY:-}" ]; then
        mode="ssh"
    fi

    if [[ "${1:-}" == "--huge" || "${1:-}" == "--bridge" ]]; then
        # Stream stdin to local bridge service
        curl -sS -X POST --data-binary @- http://localhost:9999/clip
    elif [ "$mode" = "ssh" ]; then
        # Base64 encode and output OSC 52 sequence
        local content
        content=$(cat)
        local b64
        b64=$(printf "%s" "$content" | base64 | tr -d '\r\n')
        printf "\033]52;c;%s\a" "$b64"
    else
        # Desktop copy
        _run_py_script "$HOME/.local/bin/clip_helper.py" copy
    fi
}

clippaste() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: clippaste [--huge | --bridge]"
        echo ""
        echo "Output clipboard content to stdout."
        echo ""
        echo "Options:"
        echo "  --huge, --bridge   Use local background HTTP service tunnel (requires ssh -R)"
        return 0
    fi

    local mode="local"
    if [ -n "${SSH_CONNECTION:-}" ] || [ -n "${SSH_CLIENT:-}" ] || [ -n "${SSH_TTY:-}" ]; then
        mode="ssh"
    fi

    if [[ "${1:-}" == "--huge" || "${1:-}" == "--bridge" ]]; then
        # Fetch from local bridge service
        curl -sS http://localhost:9999/clip
    elif [ "$mode" = "ssh" ]; then
        echo "Error: clippaste over SSH requires the reverse port forward bridge. Run: clippaste --huge" >&2
        return 1
    else
        # Desktop paste
        _run_py_script "$HOME/.local/bin/clip_helper.py" paste
    fi
}

clipservice() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || -z "${1:-}" ]]; then
        echo "Usage: clipservice [start | stop | status]"
        echo ""
        echo "Manage large-data clipboard paste background service."
        return 0
    fi

    local action="$1"
    local port=9999
    local pid_file="$HOME/.config/shell-kit/clip_service.pid"
    mkdir -p "$HOME/.config/shell-kit"

    case "$action" in
        start)
            # Ask for consent every time the service is started
            echo "Requesting clipboard bridge launch authorization..."
            read -r -p "Enable background large-data clipboard service on localhost:9999? (y/N): " choice
            case "$choice" in
                [yY][eE][sS]|[yY])
                    echo "Consent granted. Initializing service..."
                    ;;
                *)
                    echo "Consent declined. Service will not start."
                    return 1
                    ;;
            esac

            # Check if port is already listening
            if curl -s -o /dev/null http://localhost:9999/clip; then
                echo "Clipboard service is already running on port $port."
                return 0
            fi
            # Spawn service in background
            _run_py_script "$HOME/.local/bin/clip_service.py" >/dev/null 2>&1 &
            local pid=$!
            echo "$pid" > "$pid_file"
            # Wait brief moment and check
            sleep 0.5
            if curl -s -o /dev/null http://localhost:9999/clip; then
                echo "Clipboard service started on http://127.0.0.1:$port (PID: $pid)"
            else
                echo "Failed to start clipboard service."
                return 1
            fi
            ;;
        stop)
            if [ -f "$pid_file" ]; then
                local pid
                pid=$(cat "$pid_file")
                kill "$pid" 2>/dev/null || true
                rm -f "$pid_file"
            fi
            pkill -f clip_service.py 2>/dev/null || true
            echo "Clipboard service stopped."
            ;;
        status)
            if curl -s -o /dev/null http://localhost:9999/clip; then
                echo "Clipboard service is running on port $port."
            else
                echo "Clipboard service is stopped."
            fi
            ;;
        *)
            echo "Unknown action: $action" >&2
            echo "Usage: clipservice [start | stop | status]" >&2
            return 1
            ;;
    esac
}

schedmgr() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        _run_py_script "$HOME/.local/bin/schedmgr.py" --help
        return 0
    fi
    _run_py_script "$HOME/.local/bin/schedmgr.py" "$@"
}


