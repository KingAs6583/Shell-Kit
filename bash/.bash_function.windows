# ~/.bash_function.windows — Windows Git Bash specific functions
# Works on: Windows (Git Bash / MSYS2 / Cygwin) ONLY
# Sourced by ~/.bashrc only when PLATFORM=windows
# [windows] tag means this function is Windows-specific

# ─────────────────────────────────────────────────────────────
# WINDOWS PLATFORM GUARD
# ─────────────────────────────────────────────────────────────
if [ "${PLATFORM:-}" != "windows" ]; then
    return 0 2>/dev/null || exit 0
fi

# ─────────────────────────────────────────────────────────────
# WINDOWS PATH HELPERS  [windows]
# ─────────────────────────────────────────────────────────────

# Open current directory in Windows Explorer
# Usage: explore [path]
explore() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: explore [path]"
        return 0
    fi

    local target="${1:-.}"
    # Convert to Windows path format
    local winpath
    winpath=$(cygpath -w "$target" 2>/dev/null || echo "$target")
    explorer.exe "$winpath" 2>/dev/null || start "" "$winpath"
}

# Open a file or URL in the default Windows app
# Usage: open file.pdf  OR  open https://example.com
open() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: open <file|url>"
        return 0
    fi

    if [ -z "${1:-}" ]; then echo "Usage: open <file|url>"; return 1; fi
    start "" "$1" 2>/dev/null || cmd.exe /c start "" "$1" 2>/dev/null
}

# Convert Windows path to Unix path
# Usage: toUnix "C:\Users\kinga\file"
toUnix() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: toUnix <windows-path>"
        return 0
    fi

    if [ -z "${1:-}" ]; then echo "Usage: toUnix <windows-path>"; return 1; fi
    echo "${1}" | sed 's|\\|/|g' | sed 's|^\([A-Za-z]\):|/\L\1|'
}

# Convert Unix path to Windows path
# Usage: toWin "/c/Users/kinga/file"
toWin() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: toWin <unix-path>"
        return 0
    fi

    if [ -z "${1:-}" ]; then echo "Usage: toWin <unix-path>"; return 1; fi
    cygpath -w "${1}" 2>/dev/null || echo "${1}" | sed 's|^/\([a-z]\)/|\U\1:\\|' | sed 's|/|\\|g'
}

# ─────────────────────────────────────────────────────────────
# WINDOWS PROCESS / SYSTEM  [windows]
# ─────────────────────────────────────────────────────────────

# Kill a Windows process by name
# Usage: killwin notepad.exe
killwin() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: killwin <process.exe>"
        return 0
    fi

    if [ -z "${1:-}" ]; then echo "Usage: killwin <process.exe>"; return 1; fi
    taskkill.exe /IM "$1" /F 2>/dev/null && echo "Killed: $1" || echo "Process not found: $1"
}

# List running processes (filtered)
# Usage: pslist [filter]
pslist() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: pslist [filter]"
        return 0
    fi

    tasklist.exe 2>/dev/null | grep -i "${1:-}" | awk '{printf "%-30s %s MB\n", $1, int($5/1024)}'
}

# ─────────────────────────────────────────────────────────────
# DEVELOPER MODE CHECK  [windows]
# Checks if Windows Developer Mode is enabled (needed for symlinks)
# ─────────────────────────────────────────────────────────────
devmode() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: devmode"
        return 0
    fi

    local _GREEN='\033[0;32m'
    local _RED='\033[0;31m'
    local _RST='\033[0m'
    local result
    result=$(reg.exe query "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock" \
        /v AllowDevelopmentWithoutDevLicense 2>/dev/null | grep -i "0x1" || true)
    if [ -n "$result" ]; then
        printf "${_GREEN}  Developer Mode: ON (symlinks work in Git Bash)${_RST}\n"
    else
        printf "${_RED}  Developer Mode: OFF (symlinks may fail — enable in Settings > System > For Developers)${_RST}\n"
    fi
}
