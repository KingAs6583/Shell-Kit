# ~/.bash_function — Shell functions for Git Bash / Linux Bash
# Sourced by ~/.bashrc on interactive login.
# Keep this file cross-platform: use $PLATFORM to branch on OS differences.

# ─────────────────────────────────────────────────────────────
# PLATFORM DETECTION
# ─────────────────────────────────────────────────────────────

detect_platform() {
    case "$(uname -s)" in
        MINGW*|CYGWIN*|MSYS*) echo "windows" ;;
        Linux*)               echo "linux"   ;;
        Darwin*)              echo "mac"     ;;
        *)                    echo "unknown" ;;
    esac
}
export PLATFORM
PLATFORM=$(detect_platform)

