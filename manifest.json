{
  "version": 1,
  "repo": "shell-kit",
  "description": "Personal shell toolkit — configs, scripts, and dotfiles",
  "files": [
    {
      "src": "bash/.bashrc",
      "targets": { "windows": "~/.bashrc", "linux": "~/.bashrc", "mac": "~/.bashrc" },
      "executable": false
    },
    {
      "src": "bash/.bash_profile",
      "targets": { "windows": "~/.bash_profile", "linux": "~/.bash_profile", "mac": "~/.bash_profile" },
      "executable": false
    },
    {
      "src": "bash/.bash_function",
      "targets": { "windows": "~/.bash_function", "linux": "~/.bash_function", "mac": "~/.bash_function" },
      "executable": false,
      "note": "Deprecated: use .bash_function.both/.linux/.windows instead"
    },
    {
      "src": "bash/.bash_function.both",
      "targets": { "windows": "~/.bash_function.both", "linux": "~/.bash_function.both", "mac": "~/.bash_function.both" },
      "executable": false,
      "platform": "both"
    },
    {
      "src": "bash/.bash_function.linux",
      "targets": { "linux": "~/.bash_function.linux" },
      "executable": false,
      "platform": "linux"
    },
    {
      "src": "bash/.bash_function.windows",
      "targets": { "windows": "~/.bash_function.windows" },
      "executable": false,
      "platform": "windows"
    },
    {
      "src": "bash/.profile",
      "targets": { "windows": "~/.profile", "linux": "~/.profile", "mac": "~/.profile" },
      "executable": false
    },
    {
      "src": "scripts/history-clean.sh",
      "targets": { "windows": "~/.local/bin/history-clean.sh", "linux": "~/.local/bin/history-clean.sh", "mac": "~/.local/bin/history-clean.sh" },
      "executable": true,
      "platform": "both"
    },
    {
      "src": "scripts/setup-codebase-memory.sh",
      "targets": { "windows": "~/.local/bin/setup-codebase-memory.sh", "linux": "~/.local/bin/setup-codebase-memory.sh", "mac": "~/.local/bin/setup-codebase-memory.sh" },
      "executable": true,
      "platform": "both"
    },
    {
      "src": "scripts/scan-packages.sh",
      "targets": { "windows": "~/.local/bin/scan-packages.sh", "linux": "~/.local/bin/scan-packages.sh", "mac": "~/.local/bin/scan-packages.sh" },
      "executable": true,
      "platform": "both"
    },
    {
      "src": "scripts/linux/update.sh",
      "targets": { "linux": "~/.local/bin/update-sys.sh" },
      "executable": true,
      "platform": "linux"
    },
    {
      "src": "scripts/linux/system-info.sh",
      "targets": { "linux": "~/.local/bin/system-info.sh" },
      "executable": true,
      "platform": "linux"
    },
    {
      "src": "scripts/linux/ram-info.sh",
      "targets": { "linux": "~/.local/bin/ram-info.sh" },
      "executable": true,
      "platform": "linux"
    },
    {
      "src": "scripts/git_scanner.py",
      "targets": { "windows": "~/.local/bin/git_scanner.py", "linux": "~/.local/bin/git_scanner.py", "mac": "~/.local/bin/git_scanner.py" },
      "executable": true,
      "platform": "both"
    },
    {
      "src": "scripts/asset_backup.py",
      "targets": { "windows": "~/.local/bin/asset_backup.py", "linux": "~/.local/bin/asset_backup.py", "mac": "~/.local/bin/asset_backup.py" },
      "executable": true,
      "platform": "both"
    },
    {
      "src": "scripts/backup.py",
      "targets": { "windows": "~/.local/bin/backup.py", "linux": "~/.local/bin/backup.py", "mac": "~/.local/bin/backup.py" },
      "executable": true,
      "platform": "both"
    },
    {
      "src": "scripts/config_inspector.py",
      "targets": { "windows": "~/.local/bin/config_inspector.py", "linux": "~/.local/bin/config_inspector.py", "mac": "~/.local/bin/config_inspector.py" },
      "executable": true,
      "platform": "both"
    }
  ]
}